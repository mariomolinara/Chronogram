# Chronogram backend configuration — copy to `.env` and fill in real values.
# Save with LF (Unix) line endings.

# --- Database ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=chronogram
MYSQL_USER=chronouser
MYSQL_PASSWORD=change_me_db

# --- Spring profile ---
# The docker-compose backend defaults to the "prod" profile (application-prod.yml),
# which REQUIRES JWT_SECRET_KEY, CORS_ALLOWED_ORIGINS and APP_CANONICAL_URL below
# (no localhost fallbacks). For a local/dev run, set this to "default".
SPRING_PROFILES_ACTIVE=prod

# --- Security ---
# JWT_SECRET_KEY MUST be at least 32 characters (256-bit HMAC key). The app
# refuses to start otherwise. Generate one with:  openssl rand -base64 48
JWT_SECRET_KEY=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Comma-separated allowlist of front-end origins (NEVER use "*").
# In production this MUST be the real HTTPS origin, e.g. https://app.example.com
CORS_ALLOWED_ORIGINS=http://localhost:8100
# Canonical base URL of the front-end: used to build the link in ALL
# password-reset emails (the request Origin header is ignored). It must include
# the context path if the SPA is served under one, e.g.
# https://app.example.com/chronogram. A trailing slash is tolerated.
# Local dev default is the Vite dev server.
APP_CANONICAL_URL=http://localhost:5173

# --- Administrator account ---
# Created on first boot (Flyway V3 + AdminAccountInitializer). The account is
# flagged "must change password": ADMIN_INITIAL_PASSWORD stops working as soon as
# a new one is set from the admin page, and these values are NOT re-applied on
# later restarts. Leave ADMIN_EMAIL empty to skip provisioning entirely.
# The password must be at least 8 characters or the account is not created.
ADMIN_EMAIL=admin@chronogram.local
ADMIN_INITIAL_PASSWORD=change_me_before_first_boot

# --- Dashboard metrics (optional; defaults shown) ---
# "Active" = at least one sign-in within this many days.
STATS_ACTIVE_WINDOW_DAYS=10
# "Regular" = signed in on EVERY one of these days.
STATS_REGULAR_WINDOW_DAYS=7
# Length of the activities-per-day series on the dashboard chart.
STATS_DISTRIBUTION_DAYS=30

# --- LLM (OpenAI-compatible provider; default: regolo.ai) ---
# regolo.ai key: https://dashboard.regolo.ai  (or use OpenRouter, etc.)
LLM_API_URL=https://api.regolo.ai/v1/chat/completions
LLM_DEFAULT_MODEL=llama-3-3-70b-instruct
LLM_API_KEY=your_llm_api_key

# --- Email (SMTP) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your_email@gmail.com
MAIL_PASSWORD=your_app_password

# --- Logging ---
LOG_LEVEL=INFO
