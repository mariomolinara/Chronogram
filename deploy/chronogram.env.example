# Chronogram runtime environment on devaidalab.unicas.it — copy to
# /opt/chronogram/chronogram.env, fill in real values, then:
#   chmod 600 /opt/chronogram/chronogram.env
# The file is loaded by BOTH containers (docker-compose.prod.yml, env_file):
# the MYSQL_* values initialise the mysql container AND are read by the app as
# its DB credentials (single source of truth).
# NEVER commit the filled-in copy: it contains secrets.

# --- Database (mysql container; data persists in the mysql-data volume) ---
MYSQL_ROOT_PASSWORD=change_me_root
MYSQL_DATABASE=chronogram
MYSQL_USER=chronouser
MYSQL_PASSWORD=change_me_db

# --- Security ---
# At least 32 chars (256-bit HMAC). Generate with: openssl rand -base64 48
JWT_SECRET_KEY=change_me_to_a_random_string_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Web app is same-origin (served from the WAR) but the Android app calls from
# the Capacitor WebView origin, which must be allowed explicitly.
CORS_ALLOWED_ORIGINS=https://devaidalab.unicas.it,https://localhost,capacitor://localhost
# Canonical front-end URL used to build the link in ALL password-reset emails
# (the Origin header is ignored: it would be the bare origin from the browser and
# the WebView origin from the Android app). MUST include the /chronogram context
# path, otherwise the link 404s.
APP_CANONICAL_URL=https://devaidalab.unicas.it/chronogram

# --- Administrator account (created on first boot, then self-managed) ---
ADMIN_EMAIL=admin@chronogram.local
ADMIN_INITIAL_PASSWORD=change_me_before_first_boot

# --- Mail (password reset) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=

# --- LLM provider ---
LLM_API_URL=https://api.regolo.ai/v1/chat/completions
LLM_DEFAULT_MODEL=llama-3-3-70b-instruct
LLM_API_KEY=change_me

# --- Logging ---
LOG_LEVEL=INFO
