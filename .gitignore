# Maven & IDE
target/
*.iml
.idea/
.vscode/
*.log
*.tmp
*.bak
*.swp

# Env
*.env
*.env.*
# ...but keep the documented example
!.env.example

secrets/

# Artifacts
chronogram.war
chronogram.jar
dump.sql

# OS/system files
.DS_Store
Thumbs.db

# Old files
Dockerfile.old

# Ensure schema.sql is kept
!docker/init/schema.sql

docker/logs/

# TLS certificates / private keys — never commit these
docker/nginx/certs/
docker/nginx/certbot-webroot/
*.pem
*.key

# Android release signing — never commit secrets or keystores
keystore.properties
*.jks
*.keystore
# ...but keep the documented example
!keystore.properties.example
frontend/android/local.properties

.claude/