# Vite production environment (mode: production).
# Loaded automatically by `vite build` / `npm run build`.
#
# Base URL of the production HTTPS origin. The backend context-path
# `/chronogram` is REQUIRED (nginx proxies preserving it) because the API
# calls use paths like `/api/auth/login` without the `/chronogram` prefix.
#
# PLACEHOLDER: replace `your-domain.example` with the real public domain
# BEFORE building for production. This value is baked into the bundle at
# build time, so you must rebuild after changing it.
#
# Not a secret (just a URL) -> safe to version, but the placeholder must be
# substituted with the real domain before deploy.
VITE_API_BASE_URL=https://your-domain.example/chronogram
