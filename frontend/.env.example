# Chronogram frontend environment variables (example / documentation).
#
# Copy the value you need into `.env.development` (dev) or `.env.production`
# (build) and adjust it. Vite exposes only variables prefixed with `VITE_`
# to the client code via `import.meta.env`.
#
# VITE_API_BASE_URL
#   Base URL of the backend API. It MUST include the backend context-path
#   `/chronogram`, because the app's API calls use paths like
#   `/api/auth/login` that do NOT contain the `/chronogram` prefix.
#   The final request URL becomes: <VITE_API_BASE_URL> + <path>, e.g.
#   `https://your-domain.example/chronogram` + `/api/auth/login`.
#
#   Examples:
#     - Local dev (backend direct):  http://localhost:8080/chronogram
#     - Local dev (through nginx):   http://localhost/chronogram
#     - Production (HTTPS):          https://your-domain.example/chronogram
#
#   The value is baked into the bundle at build time (rebuild after changes).
#   It is a plain URL, not a secret.
VITE_API_BASE_URL=https://your-domain.example/chronogram

# VITE_GOOGLE_CLIENT_ID
#   OAuth client ID of type WEB from Google Cloud Console > Credentials, used
#   for "Sign in with Google" (web AND Android: the app requests tokens
#   addressed to the web client). Leave empty to hide the Google button.
#   The backend must list the same ID in GOOGLE_CLIENT_IDS (root .env).
#   Not a secret. See docs/GOOGLE_AUTH_RECAPTCHA.md for the full setup.
VITE_GOOGLE_CLIENT_ID=

# VITE_RECAPTCHA_SITE_KEY
#   reCAPTCHA v3 SITE key (public) protecting the registration form. Leave
#   empty to disable. The SECRET key goes in the backend env
#   (RECAPTCHA_SECRET_KEY): protection is real only with both configured.
#   Keys: https://www.google.com/recaptcha/admin  (add your domain AND
#   "localhost", which is the WebView origin of the Android app).
VITE_RECAPTCHA_SITE_KEY=
