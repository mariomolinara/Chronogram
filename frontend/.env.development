# Vite development environment (mode: development).
# Loaded automatically by `vite` / `npm run dev`.
#
# Base URL of the backend API. The backend context-path `/chronogram` is
# REQUIRED here because the API calls in the code use paths like
# `/api/auth/login` (they do NOT include `/chronogram`).
#
# Not a secret (just a URL) -> safe to version.
#
# Alternatives:
# - Backend direct:   http://localhost:8080/chronogram
# - Through nginx:    http://localhost/chronogram
VITE_API_BASE_URL=http://localhost:8080/chronogram

# Google sign-in / reCAPTCHA v3: empty in dev = features hidden/disabled.
# Fill with the dev credentials if you need to test them locally
# (see frontend/.env.example and docs/GOOGLE_AUTH_RECAPTCHA.md).
VITE_GOOGLE_CLIENT_ID=449417473281-6k3cijk10j3f656g6ebnl45jh7d3bb0p.apps.googleusercontent.com
VITE_RECAPTCHA_SITE_KEY=6LfmSn0tAAAAACYha2H56KMq4W16mtEheCX5FdBs
