# Chronogram Android release signing — EXAMPLE (no real secrets here).
#
# Copy this file to `keystore.properties` (same directory) and fill in the real
# values. `keystore.properties` and any *.jks / *.keystore file are git-ignored
# and MUST NEVER be committed.
#
# Alternatively, provide the same values via Gradle properties (-PstoreFile=...)
# or environment variables in CI:
#   CHRONOGRAM_STORE_FILE, CHRONOGRAM_STORE_PASSWORD,
#   CHRONOGRAM_KEY_ALIAS,  CHRONOGRAM_KEY_PASSWORD

# Path to the keystore. Relative paths are resolved from frontend/android/.
storeFile=chronogram-release.jks

# Password protecting the keystore file.
storePassword=CHANGE_ME_STORE_PASSWORD

# Alias of the key inside the keystore.
keyAlias=chronogram

# Password protecting the key (often equal to storePassword).
keyPassword=CHANGE_ME_KEY_PASSWORD
